# Backend API base (matches backend's PORT + the flat /api mount in src/routes.ts)
VITE_API_BASE_URL=http://localhost:3000/api

# The OAuth client this admin console authenticates as. It must be PUBLIC (no secret
# sent from the browser). The bootstrap client "iam-client" already owns the full
# seeded permission matrix (every resource x action, granted to its ADMIN role) — so
# rather than registering a separate client and re-granting an equivalent matrix onto
# it, the backend's BOOTSTRAP_CLIENT_TYPE was changed to PUBLIC and this points at it.
VITE_IAM_CLIENT_ID=iam-client

# Prefills the login form's access-code field (matches backend's fixed bootstrap code,
# BOOTSTRAP_CLIENT_CR_ACCESS_CODE, default "MASTER") — just a dev convenience default.
# The client is fixed, but any realm's users log in through this same portal, so each
# user still enters their OWN realm's access code; this is never sent as a static value.
VITE_CR_ACCESS_CODE=MASTER


VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEYj7C9FHpRrNR4y